{
  "source": {
    "include": ["src"],
    "includePattern": ".+\\.(js|jsx|ts|tsx)$",
    "excludePattern": "(^|\\/)node_modules(\\/|$)|(^|\\/)docs(\\/|$)|(^|\\/)dist(\\/|$)"
  },
  "opts": {
    "recurse": true,
    "destination": "docs"
  },
  "plugins": ["node_modules/jsdoc-babel"],
  "babel": {
    "extensions": ["js", "jsx", "ts", "tsx"],
    "presets": [
      "@babel/preset-env",
      "@babel/preset-typescript",
      ["@babel/preset-react", { "runtime": "automatic" }]
    ],
    "babelrc": false
  }
}